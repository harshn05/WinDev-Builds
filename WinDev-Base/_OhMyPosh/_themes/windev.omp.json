{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#56d4dd",
          "template": "{{ .UserName }}"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#56d4dd",
          "options": {
            "time_format": "15:04:05"
          },
          "template": "   {{ .CurrentDate | date .Format }}"
        },
        {
          "type": "sysinfo",
          "style": "plain",
          "foreground": "#bc8cff",
          "foreground_templates": [
            "{{ if gt .PhysicalPercentUsed 85.0 }}#ff7b72{{ else if gt .PhysicalPercentUsed 70.0 }}#e3b341{{ end }}"
          ],
          "options": {
            "precision": 0
          },
          "template": "   {{ round .PhysicalPercentUsed .Precision }}%"
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "#3fb950",
          "foreground_templates": [
            "{{ if eq \"Charging\" .State.String }}#58a6ff{{ else if le .Percentage 20 }}#ff7b72{{ else if le .Percentage 40 }}#e3b341{{ end }}"
          ],
          "options": {
            "display_error": false,
            "charged_icon": "",
            "charging_icon": "",
            "discharging_icon": ""
          },
          "template": "{{ if not .Error }} {{ .Icon }} {{ .Percentage }}%{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#e6edf3",
          "template": "{{ if .Env.WINDEV_ENV }}  <b>[{{ .Env.WINDEV_ENV }}]</b>{{ end }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#3fb950",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          },
          "template": "  {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#bc8cff{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e3b341{{ end }}",
            "{{ if gt .Ahead 0 }}#58a6ff{{ end }}",
            "{{ if gt .Behind 0 }}#ffa657{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "#3572a5",
          "foreground": "#ffffff",
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "cmake",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#064f8c",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#6ca35e",
          "foreground": "#0d1117",
          "template": "  {{ .Full }} "
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#4c1f5e",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "status",
          "style": "plain",
          "options": {
            "always_enabled": true
          },
          "template": " {{ if or (eq .Code 130) (eq .Code -1073741510) (eq .Code 3221225786) }}<#ffa657> SIGINT</>{{ else if ne .Code 0 }}<#ff7b72> {{ .Code }}</>{{ else }}<#3fb950></>{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#e3b341",
          "options": {
            "threshold": 10
          },
          "template": " {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#79c0ff",
          "options": {
            "style": "full"
          },
          "template": " {{ .Path }}"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#3fb950",
          "foreground_templates": [
            "{{ if ne .Code 0 }}#ff7b72{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": " ❯ "
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#3fb950",
    "foreground_templates": [
      "{{ if ne .Code 0 }}#ff7b72{{ end }}"
    ],
    "template": "❯ "
  }
}